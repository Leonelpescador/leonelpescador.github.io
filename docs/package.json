{
  "name": "portfolio-2025-2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint src tests scripts --max-warnings=0",
    "test": "node --test tests/content.test.mjs",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "lighthouse": "lhci autorun",
    "check": "npm run lint && npm run test && npm run build && npm run check:bundle",
    "env:copy-example": "shx -- cp -n .env.example .env",
    "env:remove": "shx -- rm -f .env"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "howler": "^2.2.4",
    "lenis": "^1.3.11",
    "three": "^0.181.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/howler": "^2.2.12",
    "@types/node": "^24.6.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "shx": "^0.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vite-plugin-glsl": "^1.6.1",
    "vue-tsc": "^3.1.0"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  }
}
